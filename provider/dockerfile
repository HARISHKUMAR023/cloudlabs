
# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /app

COPY provider/go.mod provider/go.sum ./provider/
WORKDIR /app/provider

RUN go mod download

COPY provider/ .

RUN CGO_ENABLED=0 GOOS=linux go build \
    -o /out/cloudlabs-api ./cmd/api

# Runtime stage
FROM alpine:3.22

RUN apk --no-cache add ca-certificates

WORKDIR /app

COPY --from=builder /out/cloudlabs-api ./cloudlabs-api

EXPOSE 8000

CMD ["./cloudlabs-api"]
